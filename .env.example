# ==============================================================================
# Omni-Agent Operating System - Environment Configuration Template
# Salin file ini menjadi .env dan sesuaikan dengan konfigurasi server Anda.
# ==============================================================================

# Port Web Portal Gateway (Default: 7777)
PORTAL_PORT=7777

# Host IP atau Domain Name (Biarkan kosong untuk auto-detect hostname)
HOST_IP=127.0.0.1

# AI LLM Provider Configuration
# Dify AI Agent API (Opsional - Jika menggunakan Dify di server ini atau terpisah)
DIFY_API_URL=http://127.0.0.1:8090/v1/chat-messages
DIFY_API_KEY=your_dify_api_key_here

# Local On-Premise Ollama Engine (Tier 3 Safety Net & Qwen 3B Governance)
OLLAMA_API_URL=http://127.0.0.1:11434

# Cloud AI API Keys (Tier 1 & Tier 2 Models)
GEMINI_API_KEY=your_gemini_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Ruang 3D Virtual Office Port (Default: 3001)
RUANG_PORT=3001
